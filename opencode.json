{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/my-model",
  "providers": {
    "LocalValerian": {
      "name": "Local Valerian",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:9931/v1"
      },
      "models": {
        "Local Valerian": {
          "modelID": "Valerian model",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
